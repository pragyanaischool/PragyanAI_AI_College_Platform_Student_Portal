# --- FORM VIEWS (for Admin) ---
def display_add_student_form():
    st.title("➕ Add a New Student")
    with st.form("add_student_form"):
        reg_no = st.text_input("Registration Number*")
        name = st.text_input("Full Name*")
        department = st.selectbox("Department*", ['Computer Science', 'Electronics', 'Mechanical', 'Civil', 'Biotechnology'])
        crs_score = st.number_input("Career Readiness Score (CRS)*", 0, 1000)
        cgpa = st.number_input("Current CGPA*", 0.0, 10.0, format="%.2f")
        attendance = st.number_input("Attendance (%)*", 0, 100)
        target_profile = st.text_input("Target Job Profile", placeholder="e.g., Data Scientist")

        if st.form_submit_button("Submit Student Data"):
            if not all([reg_no, name, department]):
                 st.error("Please fill in all required fields.")
            else:
                student_data = {'RegistrationNo': reg_no, 'Name': name, 'Department': department, 'CRS_Score': crs_score, 'Current_CGPA': cgpa, 'Attendance_Percentage': attendance, 'Target_Job_Profile': target_profile}
                success, message = dm.add_student(student_data)
                if success:
                    st.success(message)
                    switch_view('main')
                    st.rerun()
                else:
                    st.error(f"Failed to add student: {message}")

    if st.button("⬅️ Back to Portal"):
        switch_view('main')
        st.rerun()

def display_edit_student_form():
    st.title("✏️ Edit Student Information")
    reg_no = st.session_state.selected_student
    student = dm.get_student_by_reg_no(reg_no)

    if not student:
        st.error("Could not find student.")
        switch_view('main')
        st.rerun()

    with st.form("edit_student_form"):
        st.subheader(f"Editing: {student['Name']}")
        name = st.text_input("Full Name*", value=student['Name'])
        department = st.selectbox("Department*", ['Computer Science', 'Electronics', 'Mechanical', 'Civil', 'Biotechnology'], index=['Computer Science', 'Electronics', 'Mechanical', 'Civil', 'Biotechnology'].index(student['Department']))
        crs_score = st.number_input("CRS*", 0, 1000, value=int(student['CRS_Score']))
        cgpa = st.number_input("CGPA*", 0.0, 10.0, value=float(student['Current_CGPA']), format="%.2f")
        attendance = st.number_input("Attendance (%)*", 0, 100, value=int(student['Attendance_Percentage']))
        target_profile = st.text_input("Target Profile", value=student.get('Target_Job_Profile', ''))

        if st.form_submit_button("Save Changes"):
            updated_data = {'Name': name, 'Department': department, 'CRS_Score': crs_score, 'Current_CGPA': cgpa, 'Attendance_Percentage': attendance, 'Target_Job_Profile': target_profile}
            success, message = dm.update_student(reg_no, updated_data)
            if success:
                st.success(message)
                switch_view('main')
                st.rerun()
            else:
                st.error(f"Failed to update: {message}")

    if st.button("⬅️ Back to Portal"):
        switch_view('main')
        st.rerun()


# --- MAIN APP ROUTER ---
if not st.session_state.authentication_status:
    display_login_page()
else:
    role = st.session_state.user_role
    if role in ['faculty', 'management']:
        display_admin_portal()
    elif role == 'student':
        display_student_portal()
    elif role == 'parent':
        display_parent_portal()
