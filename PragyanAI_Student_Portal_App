# --- Session State Initialization ---
if 'authentication_status' not in st.session_state:
    st.session_state.authentication_status = None
if 'user_role' not in st.session_state:
    st.session_state.user_role = None
if 'username' not in st.session_state:
    st.session_state.username = None
if 'view' not in st.session_state:
    st.session_state.view = 'main'
if 'selected_student' not in st.session_state:
    st.session_state.selected_student = None

# --- Helper Functions ---
def switch_view(view_name, student_reg_no=None):
    st.session_state.view = view_name
    st.session_state.selected_student = student_reg_no

def logout():
    st.session_state.authentication_status = None
    st.session_state.user_role = None
    st.session_state.username = None
    st.session_state.view = 'main'
    st.rerun()

# --- LOGIN PAGE ---
def display_login_page():
    st.title("Welcome to the PragyanAI Portal")
    st.write("Please select your role and log in to continue.")

    login_tabs = st.tabs(["Student", "Parent", "Faculty", "Management"])

    # --- Student Login ---
    with login_tabs[0]:
        st.header("Student Login")
        with st.container():
            student_reg_no = st.text_input("Registration Number", key="student_reg_no", placeholder="e.g., S001")
            if st.button("Login as Student", key="student_login_btn"):
                if dm.student_exists(student_reg_no):
                    st.session_state.authentication_status = True
                    st.session_state.user_role = 'student'
                    st.session_state.username = student_reg_no
                    st.rerun()
                else:
                    st.error("Invalid Registration Number.")

    # --- Parent Login ---
    with login_tabs[1]:
        st.header("Parent Login")
        with st.container():
            parent_reg_no = st.text_input("Student's Registration Number", key="parent_reg_no")
            parent_password = st.text_input("Password", type="password", key="parent_password")
            if st.button("Login as Parent", key="parent_login_btn"):
                if dm.student_exists(parent_reg_no) and parent_password == 'parent123':
                    st.session_state.authentication_status = True
                    st.session_state.user_role = 'parent'
                    st.session_state.username = parent_reg_no
                    st.rerun()
                else:
                    st.error("Invalid credentials.")

    # --- Faculty & Management Logins (combined for simplicity in this version) ---
    for i, role in enumerate(["Faculty", "Management"]):
        with login_tabs[i+2]:
            st.header(f"{role} Login")
            with st.container():
                username = st.text_input("Username", key=f"{role.lower()}_user")
                password = st.text_input("Password", type="password", key=f"{role.lower()}_pass")
                if st.button(f"Login as {role}", key=f"{role.lower()}_login_btn"):
                    if username.lower() == role.lower() and password == f'{role.lower()}123':
                        st.session_state.authentication_status = True
                        st.session_state.user_role = role.lower()
                        st.session_state.username = username
                        st.rerun()
                    else:
                        st.error("Invalid credentials.")

# --- DASHBOARDS (POST-LOGIN) ---

def display_admin_portal():
    st.sidebar.header(f"Welcome, {st.session_state.username.capitalize()}!")
    st.sidebar.markdown(f"**Role:** `{st.session_state.user_role.capitalize()}`")
    st.sidebar.button("Logout", on_click=logout, use_container_width=True)

    if st.session_state.view == 'main':
        st.title("👨‍🎓 Student Data Portal")
        st.write("Manage and visualize student data.")

        student_df = dm.load_data()

        st.subheader("Departmental CRS Analysis")
        if not student_df.empty:
            avg_crs_by_dept = student_df.groupby('Department')['CRS_Score'].mean().reset_index()
            fig = px.bar(avg_crs_by_dept, x='Department', y='CRS_Score', title='Average Career Readiness Score by Department',
                         labels={'CRS_Score': 'Average CRS Score'}, color_discrete_sequence=['#00C49A'])
            st.plotly_chart(fig, use_container_width=True)

        if st.button("➕ Add New Student"):
            switch_view('add')
            st.rerun()

        st.header("All Student Records")
        st.dataframe(student_df, use_container_width=True)

        reg_no_to_edit = st.selectbox("Select a Student to Edit by Registration No:", [""] + list(student_df['RegistrationNo']))
        if reg_no_to_edit:
            if st.button("✏️ Edit Selected Student"):
                switch_view('edit', student_reg_no=reg_no_to_edit)
                st.rerun()
    elif st.session_state.view == 'add':
        display_add_student_form()
    elif st.session_state.view == 'edit':
        display_edit_student_form()

